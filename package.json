{
  "name": "taripro",
  "productName": "tariPRO",
  "version": "0.1.0",
  "description": "Tarifa profesional de impresión digital: costes, márgenes, precios y PDF A4.",
  "author": "Luis Giménez (Impress Marketing)",
  "private": true,
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "app": "electron .",
    "dist": "electron-builder --publish never",
    "test": "node --test tests/"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "es.impr.taripro",
    "productName": "tariPRO",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "app/**",
      "public/**",
      "!public/**/*.json",
      "electron/**",
      "CHANGELOG.md",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "zreedeecom",
      "repo": "tariPRO",
      "releaseType": "draft"
    }
  }
}
